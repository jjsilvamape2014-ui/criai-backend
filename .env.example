# Database (local via Docker: postgresql://postgres:senha123@localhost:5432/criai?schema=public)
DATABASE_URL="postgresql://user:password@localhost:5432/criai?schema=public"

# JWT (gere uma chave forte com 32+ caracteres)
JWT_SECRET="sua-chave-secreta-super-segura-aqui-minimo-32-caracteres"

# Fal.ai (imagens premium + upscale 4K + vídeo)
# Crie em: https://fal.ai/dashboard/keys
FAL_KEY=""

# Stability AI (gratuito - ~25 creditos, ~8 imagens)
# Crie em: https://platform.stability.ai/account/keys
STABILITY_API_KEY=""

# Imagga (análise de imagem: OCR, remoção de fundo)
IMAGGA_API_KEY=""
IMAGGA_API_SECRET=""

# Hugging Face (fallback gratuito)
HF_API_KEY=""

# IA de texto para o Cérebro Visual (chat de edição de imagens)
# OpenAI (sk-...) ou Gemini (AIza...). Deixe LLM_MODEL vazio para o padrão.
# Padrões: gpt-4o-mini (OpenAI) / gemini-1.5-flash (Gemini)
LLM_API_KEY=""
LLM_MODEL=""

# Replicate (fallback para vídeos - descontinuado)
REPLICATE_API_TOKEN=""

# Stripe - para cobrar em produção, use chaves LIVE (sk_live_, pk_live_)
# Crie em: https://dashboard.stability.ai/api-keys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook: gere com `node src/scripts/register-webhook.js https://backend.up.railway.app`
# e cole o secret aqui (começa com whsec_)
STRIPE_WEBHOOK_SECRET=""
# Se vazio, o backend cria o price de R$39,99/mês automaticamente via price_data
STRIPE_PRICE_PREMIUM=""

# Frontend URL (use o domínio do frontend em produção)
FRONTEND_URL="http://localhost:3000"
PORT=3001

# Anúncio em vídeo com voz (Cérebro Visual)
# kling = cenas com movimento real (Kling via fal, ~3 vídeos por anúncio, mais caro)
# kenburns = só zoom lento nas imagens (barato, sem chamada de vídeo)
AD_SCENE_MODE=kling
# Vozes do Kokoro PT-BR (confira os nomes na página do modelo no fal)
AD_VOICE_FEMALE=pf_dora
AD_VOICE_MALE=pm_alex

# Custo dos vídeos do Cérebro, em créditos (1 crédito ≈ 1 imagem). ATENÇÃO: valores
# antigos (1 e 3) eram de outra unidade — apague essas variáveis no Railway.
# AD_VIDEO_CREDITS=30
# Comercial com apresentador (várias cenas + lipsync): usa bem mais IA
# AD_PRESENTER_CREDITS=40
# Modelo de lipsync na fal (boca sincronizada com a voz)
# FAL_LIPSYNC_ENDPOINT=fal-ai/sync-lipsync/v3/image-to-video

# Voz: fal (Kokoro) é a principal; se falhar (ex.: saldo esgotado) usa a voz grátis
# do Microsoft Edge (pacote msedge-tts; serviço não oficial, pode mudar sem aviso).
# TTS_PROVIDER=edge   → usa a voz grátis como principal (economiza fal)
# TTS_FALLBACK=false  → desliga a reserva grátis

# Vídeo com IA (fal.ai) — Kling 3 Turbo Standard por padrão (3 a 15 s, várias cenas num vídeo)
# VIDEO_I2V_MODEL=fal-ai/kling-video/v3/turbo/standard/image-to-video
# VIDEO_T2V_MODEL=fal-ai/kling-video/v3/turbo/standard/text-to-video
# Reserva se o modelo novo falhar ("none" desliga)
# VIDEO_LEGACY_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# Créditos a cada 5 s de vídeo (padrão 10: 5 s = 10, 15 s = 30)
# VIDEO_CREDITS_PER_5S=10
# Anúncio "com fotos" filmado numa tomada só (false = uma animação por cena, como antes)
# AD_MULTISHOT=true
# photo = o anúncio filmado (Kling 3) vira o padrão; sem isso, o padrão é motion graphics
# AD_DEFAULT_STYLE=motion
# Planos (src/plans.js). Valores em centavos.
# PREMIUM_PRICE_CENTS=4990         # R$ 49,90/mês (se STRIPE_PRICE_PREMIUM existir, o Stripe manda)
# PREMIUM_MONTHLY_IMAGES=50
# PREMIUM_VIDEO_LIMIT=30           # créditos de vídeo por mês (30 = 15 s); 0 = ilimitado
# FREE_MONTHLY_IMAGES=10
# FREE_MONTHLY_VIDEO_CREDITS=10    # 10 = um vídeo de 5 s
# PACK_30_CENTS=1990
# PACK_100_CENTS=5990
# PACK_250_CENTS=13990

# Roteador do Cérebro (entende o pedido antes de agir)
# ROUTER_TIMEOUT_MS=45000
# ROUTER_REASONING_EFFORT=low

# Imagem do zero: com texto → Ideogram 3; sem texto → FLUX 2 Pro ("fluxpro" volta ao antigo)
# IMAGE_MODEL_TEXT=ideogram
# IMAGE_MODEL_PHOTO=flux2pro
# Contas sem limite nem cobrança de vídeo (ex.: o dono testando), separadas por vírgula
# VIDEO_UNLIMITED_EMAILS=seu@email.com

# Anúncio sem pista de estilo: filmado (padrão) ou "motion" (cards animados, mais barato)
# AD_DEFAULT_STYLE=photo
