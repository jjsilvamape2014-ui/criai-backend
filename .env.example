# Database (local via Docker: postgresql://postgres:senha123@localhost:5432/criai?schema=public)
DATABASE_URL="postgresql://user:password@localhost:5432/criai?schema=public"

# JWT (gere uma chave forte com 32+ caracteres)
JWT_SECRET="sua-chave-secreta-super-segura-aqui-minimo-32-caracteres"

# Fal.ai (imagens premium + upscale 4K + vídeo)
# Crie em: https://fal.ai/dashboard/keys
FAL_KEY=""

# Stability AI (gratuito - ~25 creditos, ~8 imagens)
# Crie em: https://platform.stability.ai/account/keys
STABILITY_API_KEY=""

# Imagga (análise de imagem: OCR, remoção de fundo)
IMAGGA_API_KEY=""
IMAGGA_API_SECRET=""

# Hugging Face (fallback gratuito)
HF_API_KEY=""

# IA de texto para o Cérebro Visual (chat de edição de imagens)
# OpenAI (sk-...) ou Gemini (AIza...). Deixe LLM_MODEL vazio para o padrão.
# Padrões: gpt-4o-mini (OpenAI) / gemini-1.5-flash (Gemini)
LLM_API_KEY=""
LLM_MODEL=""

# Replicate (fallback para vídeos - descontinuado)
REPLICATE_API_TOKEN=""

# Stripe - para cobrar em produção, use chaves LIVE (sk_live_, pk_live_)
# Crie em: https://dashboard.stability.ai/api-keys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook: gere com `node src/scripts/register-webhook.js https://backend.up.railway.app`
# e cole o secret aqui (começa com whsec_)
STRIPE_WEBHOOK_SECRET=""
# Se vazio, o backend cria o price de R$39,99/mês automaticamente via price_data
STRIPE_PRICE_PREMIUM=""

# Frontend URL (use o domínio do frontend em produção)
FRONTEND_URL="http://localhost:3000"
PORT=3001
