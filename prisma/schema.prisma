generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  name              String?
  plan              Plan           @default(FREE)
  creditsImages     Int            @default(10)  @map("credits_images")
  creditsVideos     Int            @default(2)   @map("credits_videos")
  creditsPurchased  Int            @default(0)  @map("credits_purchased")
  monthlyResetDate  DateTime?      @map("monthly_reset_date")
  stripeCustomerId  String?        @unique @map("stripe_customer_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  generations       Generation[]
  payments          Payment[]

  @@map("users")
}

model Generation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        Type     // IMAGE ou VIDEO
  prompt      String
  negativePrompt String? @map("negative_prompt")
  imageUrl    String?  @map("image_url")
  status      Status   @default(PENDING)
  cost        Int      @default(1)  // créditos consumidos
  createdAt   DateTime @default(now()) @map("created_at")
  motionPresetId String? @map("motion_preset_id") // preset de câmera (opcional, slice 1)

  user        User     @relation(fields: [userId], references: [id])
  // Sem @relation/foreign key de propósito: a FK saiu da migração para o re-aplicar
  // no boot ser idempotente (ver prisma/migrations/20261018143052_add_motion_presets).

  @@index([motionPresetId])
  @@map("generations")
}

// Registry dos 65 presets de movimento de câmera (slice 1). A fonte de verdade é o
// JSON em src/data/motion-presets.json; as linhas entram pelo sync idempotente
// src/scripts/sync-motion-presets.js (upsert por slug, só com a tabela vazia).
// prompt/negative são em inglês (o que vai para o modelo); labelPt é o rótulo da UI.
model MotionPreset {
  id                String   @id
  slug              String   @unique
  name              String
  group             String
  labelPt           String?  @map("label_pt")
  prompt            String
  negative          String
  supportedModels   String[] @default([]) @map("supported_models")
  badge             String?  // 'top_choice' (curadoria própria)
  confidence        String   @default("medium") // 'high' | 'medium' | 'low'
  originalBaseModel String?  @map("original_base_model")
  previewUrl        String?  @map("preview_url")
  enabled           Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([group, position])
  @@index([enabled, position])
  @@map("motion_presets")
}

model Payment {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  stripePaymentId String?  @map("stripe_payment_id")
  amount        Int      // em centavos
  currency      String   @default("brl")
  status        PaymentStatus @default(PENDING)
  type          PaymentType   @default(CREDITS)
  creditsAmount Int?     @map("credits_amount")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id])

  @@map("payments")
}

enum Plan {
  FREE
  PREMIUM
}

enum Type {
  IMAGE
  VIDEO
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  SUBSCRIPTION
  CREDITS
}
